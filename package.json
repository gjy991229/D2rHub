{
  "name": "d2rhub",
  "private": true,
  "version": "0.9.121",
  "description": "Windows multi-account manager and audio telemetry run tracker for Diablo II: Resurrected",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjy991229/D2RHub.git"
  },
  "homepage": "https://github.com/gjy991229/D2RHub#readme",
  "bugs": {
    "url": "https://github.com/gjy991229/D2RHub/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && npm test && npm run check:guide && npm run test:publisher && python scripts/test_generate_area_name_aliases.py",
    "build": "tsc && vite build",
    "package:mod-resources": "python scripts/release-workflow.py --target mods",
    "build:desktop": "tauri build",
    "build:nsis": "tauri build --bundles nsis",
    "check:guide": "node scripts/check-guide-resources.cjs",
    "baseline:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-release-baseline.ps1",
    "test": "node scripts/run-tests.cjs && vitest run",
    "test:logic": "node scripts/run-tests.cjs",
    "test:ui": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "publish:downloads": "python scripts/publish-downloads.py",
    "test:publisher": "python scripts/test_publish_downloads.py && python scripts/test_release_workflow.py && python scripts/test_release_platforms.py && python scripts/test_repair_update_cache.py && python scripts/test_publish_vision_resources.py",
    "release": "python scripts/release-workflow.py",
    "build:processor": "python scripts/build-bundled-processor.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
