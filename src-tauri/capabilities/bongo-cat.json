{
  "identifier": "desktop-pet",
  "description": "Least-privilege capability for the desktop pet",
  "windows": ["bongo-cat"],
  "permissions": [
    "desktop-pet-commands",
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging"
  ]
}
